# Team Sync is entirely optional. Leave these unset and the app runs
# 100% local-only (the default) — no backend, no cost, no signup required.
#
# To enable live multi-device/team sync:
#   1. Create a free project at https://supabase.com
#   2. Open the SQL Editor and run supabase/schema.sql
#   3. Copy your Project URL and anon/public key below (Project Settings > API)
#   4. Rename this file to .env, restart the dev server (or redeploy)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
