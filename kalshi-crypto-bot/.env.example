# Only needed for live trading or the authenticated CF Benchmarks price feed.
# Create a key at kalshi.com (or demo.kalshi.co): Account & security -> API Keys.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/path/to/kalshi-key.pem
# Alternatively paste the PEM itself (\n escapes are accepted):
# KALSHI_PRIVATE_KEY=
# prod or demo
KALSHI_ENV=demo
